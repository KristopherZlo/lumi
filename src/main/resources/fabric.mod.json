{
  "schemaVersion": 1,
  "id": "lumi",
  "version": "${version}",
  "name": "Lumi",
  "description": "Fast, durable world history for Minecraft builders.",
  "authors": ["Zlo"],
  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.lumi.LumiMod"],
    "client": ["io.github.lumi.client.LumiClient"]
  },
  "mixins": ["lumi.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": ">=${fabric_api_version}"
  }
}
